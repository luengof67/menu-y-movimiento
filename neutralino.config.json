{
  "applicationId": "es.menuymovimiento.app",
  "version": "3.3.0",
  "defaultMode": "window",
  "port": 51783,
  "documentRoot": "/www/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [],
  "modes": {
    "window": {
      "title": "Menú y Movimiento",
      "width": 960,
      "height": 680,
      "minWidth": 360,
      "minHeight": 480,
      "center": true,
      "icon": "/www/icon.png",
      "enableInspector": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "maximize": true
    }
  },
  "cli": {
    "binaryName": "MenuYMovimiento",
    "resourcesPath": "/www/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0"
  }
}